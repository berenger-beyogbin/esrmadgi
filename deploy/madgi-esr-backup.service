[Unit]
Description=Sauvegarde PostgreSQL quotidienne MADGI ESR
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
Environment=SUPABASE_DB_CONTAINER=supabase-db
Environment=BACKUP_DIR=/var/backups/madgi-esr
ExecStart=/usr/local/sbin/madgi-esr-backup

[Install]
WantedBy=multi-user.target
