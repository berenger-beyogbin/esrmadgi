# MADGI ESR - Variables d'administration locale
# Copiez ce fichier en .env.admin.local et remplissez les vraies valeurs.
# .env.admin.local est ignore par Git. Ne commitez jamais vos vraies cles.

# URL du projet Supabase (identique a VITE_SUPABASE_URL)
SUPABASE_URL="https://example.supabase.co"

# Cle service_role a recuperer dans Supabase Dashboard > Project Settings > API.
# ATTENTION : ne jamais mettre cette cle dans src/ ni dans les variables VITE_.
SUPABASE_SERVICE_ROLE_KEY="replace-with-your-service-role-key"

# Email de l'utilisateur Supabase Auth a creer ou reparer
MADGI_ADMIN_EMAIL="admin@example.ci"

# Mot de passe a definir pour cet utilisateur Auth
MADGI_ADMIN_PASSWORD="replace-with-a-strong-password"

# Matricule tel qu'il existe dans public.utilisateurs
MADGI_ADMIN_MATRICULE="MATRICULE_ADMIN"
