{
  "name": "madgi-esr-api",
  "private": true,
  "version": "1.0.0",
  "description": "MADGI ESR — API backend intermediaire Node.js / Express / TypeScript",
  "scripts": {
    "dev": "cross-env NODE_ENV=development ENABLE_DEMO_AUTH=true tsx watch src/index.ts",
    "start": "node -e \"process.env.NODE_ENV='production'; require('./dist/index.js')\"",
    "build": "tsc",
    "lint": "tsc --noEmit",
    "test:actuarial": "tsx --test src/services/moteur-actuariel.service.test.ts",
    "test": "tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.3.0",
    "mysql2": "^3.11.3",
    "nodemailer": "^9.0.3",
    "pdf-lib": "^1.17.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.1",
    "cross-env": "^10.1.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  },
  "overrides": {
    "ip-address": "10.5.0"
  }
}
